static func pick_greeting(is_anomaly: bool, anomaly_id: String, weirdo_id: String, rng: RandomNumberGenerator) -> String:
	if weirdo_id != "" and WEIRDO_GREETINGS.has(weirdo_id):
		var arr: Array = WEIRDO_GREETINGS[weirdo_id]
		return str(arr[rng.randi() % arr.size()])
	if is_anomaly:
		if anomaly_id == "desync_speech":
			return DESYNC_GREETINGS[rng.randi() % DESYNC_GREETINGS.size()]
		if rng.randf() < 0.72:
			return ANOMALY_GREETINGS[rng.randi() % ANOMALY_GREETINGS.size()]
	return NORMAL_GREETINGS[rng.randi() % NORMAL_GREETINGS.size()]
