static func get_rules_up_to_night(night_num: int, endless: bool) -> Array[String]:
	var out: Array[String] = []
	var max_n: int = 5 if endless else clampi(night_num, 1, 5)
	for block: Dictionary in RULES_BY_NIGHT:
		if int(block["night"]) <= max_n:
			var arr: Array = block["rules"]
			for line: Variant in arr:
				out.append(str(line))
	return out


static func get_notes_up_to_night(night_num: int, endless: bool) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var max_n: int = 5 if endless else clampi(night_num, 1, 5)
	for note: Dictionary in LORE_NOTES:
		if int(note["night"]) <= max_n:
			out.append(note)
	return out
